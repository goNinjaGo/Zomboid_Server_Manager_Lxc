[Unit]
Description=Zomboid Manager LXC game container
After=lxc-net.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/zomboid-lxc-manager container-start
ExecStop=/usr/local/sbin/zomboid-lxc-manager container-stop
TimeoutStartSec=90
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
